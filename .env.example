# Example environment configuration for PhysioApp
# Unset or unknown FLASK_ENV defaults to production (secure cookies).
# Local HTTP: set FLASK_ENV=development here or in the shell (not in .flaskenv).
# pytest: testing (also set in tests/conftest.py).
# Aliases: prod → production, dev → development.
FLASK_ENV=development
SECRET_KEY=change-me
# Public origin for verification emails, OAuth redirect_uri, Calendar
# callbacks and Stripe success/cancel/return URLs. Never built from the
# request Host. Replaces OAUTH_REDIRECT_BASE.
APP_BASE_URL=https://www.trxck.tech
# Comma-separated Host values Flask 3.1+ will accept. Any other Host or
# X-Forwarded-Host is rejected with 400. Production default is
# www.trxck.tech,trxck.tech. Tests use localhost.
TRUSTED_HOSTS=www.trxck.tech,trxck.tech
# Optional. Leave unset so Flask uses the request Host (www.trxck.tech today).
# SERVER_NAME=
CALENDLY_API_TOKEN=
DEEPSEEK_API_KEY=
DEEPSEEK_API_ENDPOINT=https://api.deepseek.com/v1/chat/completions
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
