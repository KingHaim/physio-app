# .env.example — copy to .env (never commit .env). No real values here.

# --- Core ---------------------------------------------------------------
FLASK_ENV=development                 # development | production | testing  (MUST be "production" on PythonAnywhere; default is development => DEBUG=True, SQL echo)
SECRET_KEY=                           # required; generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
LOG_LEVEL=INFO
SERVER_NAME=trxck.tech                # production only; leave unset locally
# PREFERRED_URL_SCHEME is set by config class (http dev / https prod)

# --- Database -----------------------------------------------------------
# Local dev: leave empty to use SQLite at instance/physio-2.db
# Production (Supabase): use the postgresql:// scheme (NOT postgres://), e.g.
#   postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require
DATABASE_URL=
TEST_DATABASE_URL=                    # optional; tests fall back to SQLite instance/test_physio.db when empty

# --- Field encryption ---------------------------------------------------
DISABLE_ENCRYPTION=true               # "true" (default) stores PII unencrypted
FERNET_SECRET_KEY=                    # generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- Email (Brevo SMTP in production) -----------------------------------
MAIL_SERVER=smtp-relay.brevo.com      # config default is smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@trxck.tech

# --- Error monitoring ---------------------------------------------------
SENTRY_DSN=                           # empty disables Sentry

# --- Integrations -------------------------------------------------------
CALENDLY_API_TOKEN=
DEEPSEEK_API_KEY=
DEEPSEEK_API_ENDPOINT=https://api.deepseek.com/v1/chat/completions   # only read by helper scripts; app code hardcodes the URL
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe (currently NOT read: config.py hardcodes None, PAYMENTS_ENABLED=False) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Optional: one-off admin scripts (add_admin_user.py etc.) -----------
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_IS_ADMIN=true
