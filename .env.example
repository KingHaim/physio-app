# Example environment configuration for PhysioApp
# Unset or unknown FLASK_ENV defaults to production (secure cookies).
# Local HTTP: development. pytest: testing (also set in tests/conftest.py).
FLASK_ENV=development
SECRET_KEY=change-me
# Optional. Leave unset so Flask uses the request Host (www.trxck.tech today).
# SERVER_NAME=
# OAUTH_REDIRECT_BASE=
CALENDLY_API_TOKEN=
DEEPSEEK_API_KEY=
DEEPSEEK_API_ENDPOINT=https://api.deepseek.com/v1/chat/completions
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

